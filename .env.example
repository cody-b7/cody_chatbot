# ---- AI 게이트웨이 (코디세이 공개 API) ----
# 콘솔 > MY > API 키 관리 에서 발급. 권한은 "채팅"만 체크.
AI_API_KEY=
# OpenAI 호환 엔드포인트. "/v1" 까지만 (SDK가 뒤에 /chat/completions 를 붙임)
AI_BASE_URL=https://copa.codyssey.kr/v1
# 모델 ID는 콘솔 "모델별 차감 가중치" 표 기준.
# ※ Anthropic 계열(claude-*)은 OpenAI 호환 키로 호출되지 않는다 (400). Google/OpenAI 계열만 가능.
AI_MODEL=gemini-3-flash
AI_FALLBACK_MODEL=gpt-5-mini
AI_TIMEOUT=30
AI_TEMPERATURE=0.7
AI_MAX_CONTEXT_TURNS=5
# true 면 실제 호출 없이 더미 응답 — A·B는 이걸 켜고 개발 (토큰 절약)
AI_MOCK=true

# ---- 앱 ----
# python -c "import secrets; print(secrets.token_hex(32))" 로 생성
SESSION_SECRET_KEY=
DATABASE_URL=sqlite:///./data/chatbot.db
LOG_LEVEL=INFO
MAX_MESSAGE_LENGTH=1000

# ---- 개발 편의 ----
# 인증 완성 전까지 첫 사용자로 자동 로그인. 배포 시 반드시 false.
DEV_AUTH_BYPASS=true
